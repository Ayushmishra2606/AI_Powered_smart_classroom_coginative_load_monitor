# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and modify for your local development environment.
# DO NOT commit the actual '.env' file to version control.
# ==============================================================================

# Flask Environment (development / production)
FLASK_ENV=development

# Security Key (Required for production)
# Generate a random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-key-change-me

# Database Connection (Optional)
# Leave blank to use local SQLite in development.
# Render Paid Tier: Set to your PostgreSQL URL (postgres://user:pass@host/db)
DATABASE_URL=

# Port for local server (Default: 5000)
PORT=5000

# ==============================================================================
# AI / Smart Classroom Thresholds
# ==============================================================================
# Interval between AI analyses (seconds)
SIMULATION_INTERVAL=3

# Attention score below this triggers an alert
ATTENTION_ALERT_THRESHOLD=40

# Cognitive load score above this triggers an alert
COGNITIVE_ALERT_THRESHOLD=75

# Number of distracted students needed to trigger a class-wide alert
DISTRACTION_ALERT_COUNT=3
